{
  "name": "@heavy-duty/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "backup:run": "tsx src/modules/system/backup/run.ts",
    "backup:scheduler": "tsx src/modules/system/backup/scheduler.ts",
    "backup:verify": "tsx src/modules/system/backup/verify.ts",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check"
  },
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "@hono/swagger-ui": "0.6.2",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.2.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.19",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "vite": "8.3.6",
    "vitest": "5.1.1"
  }
}
