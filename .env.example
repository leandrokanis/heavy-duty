# Copy to .env only to override a default. The development environment starts without .env.
# Never commit .env. Production values come from the PO, outside Git.

# Runtime mode of the API and the web app: development, test or production.
NODE_ENV=development

# Port the API listens on inside its container or on the host.
PORT=3001

# SQLite file of the API. Required in production; development defaults to data/heavy-duty.dev.sqlite.
DATABASE_PATH=./data/heavy-duty.dev.sqlite

# Host port of the development proxy, bound to 127.0.0.1.
PROXY_PORT=8080

# Set to true when the bind mount does not deliver file change events (polling watcher).
DEV_WATCH_POLLING=false

# Port of the production build that the end-to-end suite starts.
E2E_PORT=3100

# Production only: host folder of the SQLite file, outside the repository checkout.
HEAVY_DUTY_DATA_DIR=<HEAVY_DUTY_DATA_DIR>

# Production only: Cloudflare Tunnel identifier and the host path of its credentials file.
CLOUDFLARE_TUNNEL_ID=<CLOUDFLARE_TUNNEL_ID>
CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=<CLOUDFLARE_TUNNEL_CREDENTIALS_FILE>
