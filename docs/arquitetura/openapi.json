{
  "openapi": "3.1.0",
  "info": {
    "title": "Heavy Duty API",
    "version": "0.0.0",
    "description": "HTTP API of the Heavy Duty training app."
  },
  "components": {
    "schemas": {
      "HealthUp": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "example": "recurso não encontrado"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "HealthDown": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report the API and database status",
        "responses": {
          "200": {
            "description": "The API is running and the database answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUp"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The API is running but the database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDown"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
