{
  "openapi": "3.1.0",
  "info": {
    "title": "Heavy Duty API",
    "version": "0.0.0",
    "description": "HTTP API of the Heavy Duty training app."
  },
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hd_session"
      }
    },
    "schemas": {
      "HealthUp": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "not_found"
          },
          "message": {
            "type": "string",
            "example": "recurso não encontrado"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "HealthDown": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "CeremonyOptions": {
        "type": "object",
        "additionalProperties": {},
        "description": "PublicKeyCredential options JSON for @simplewebauthn/browser"
      },
      "EnrollmentRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Token from the enrollment link fragment"
          },
          "response": {
            "description": "RegistrationResponseJSON from the browser"
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "expiresAt": {
            "type": "string",
            "example": "2026-12-21T12:00:00.000Z"
          }
        },
        "required": [
          "expiresAt"
        ]
      },
      "SignInRequest": {
        "type": "object",
        "properties": {
          "response": {
            "description": "AuthenticationResponseJSON from the browser"
          }
        }
      },
      "MuscleGroupList": {
        "type": "object",
        "properties": {
          "muscleGroups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MuscleGroup"
            }
          }
        },
        "required": [
          "muscleGroups"
        ]
      },
      "MuscleGroup": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "0193a1b2-0000-7000-8000-000000000001"
          },
          "slug": {
            "type": "string",
            "example": "triceps"
          },
          "name": {
            "type": "string",
            "example": "tríceps"
          },
          "position": {
            "type": "integer",
            "example": 6
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "position"
        ]
      },
      "MuscleList": {
        "type": "object",
        "properties": {
          "muscles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Muscle"
            }
          }
        },
        "required": [
          "muscles"
        ]
      },
      "Muscle": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "0193a1b2-0000-7000-8000-000000000101"
          },
          "slug": {
            "type": "string",
            "example": "triceps-braquial"
          },
          "name": {
            "type": "string",
            "example": "tríceps braquial"
          },
          "muscleGroup": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "0193a1b2-0000-7000-8000-000000000001"
              },
              "slug": {
                "type": "string",
                "example": "triceps"
              },
              "name": {
                "type": "string",
                "example": "tríceps"
              }
            },
            "required": [
              "id",
              "slug",
              "name"
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "muscleGroup"
        ]
      },
      "AddMuscleInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "tríceps braquial"
          },
          "muscleGroupSlug": {
            "type": "string",
            "example": "triceps"
          }
        }
      },
      "ExerciseList": {
        "type": "object",
        "properties": {
          "exercises": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Exercise"
            }
          }
        },
        "required": [
          "exercises"
        ]
      },
      "Exercise": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "0193a1b2-0000-7000-8000-000000000201"
          },
          "slug": {
            "type": "string",
            "example": "supino-reto"
          },
          "name": {
            "type": "string",
            "example": "Supino reto"
          },
          "kind": {
            "$ref": "#/components/schemas/ExerciseKind"
          },
          "muscles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExerciseMuscle"
            }
          },
          "muscleGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "example": "0193a1b2-0000-7000-8000-000000000001"
                },
                "slug": {
                  "type": "string",
                  "example": "triceps"
                },
                "name": {
                  "type": "string",
                  "example": "tríceps"
                }
              },
              "required": [
                "id",
                "slug",
                "name"
              ]
            }
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "kind",
          "muscles",
          "muscleGroups"
        ]
      },
      "ExerciseKind": {
        "type": "string",
        "enum": [
          "reps",
          "time"
        ]
      },
      "ExerciseMuscle": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Muscle"
          },
          {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary"
                ],
                "example": "secondary"
              }
            },
            "required": [
              "role"
            ]
          }
        ]
      },
      "AddExerciseInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Supino reto"
          },
          "kind": {
            "type": "string",
            "example": "reps"
          },
          "primaryMuscleSlugs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "peitoral-maior"
            ]
          },
          "secondaryMuscleSlugs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "triceps-braquial"
            ]
          }
        }
      },
      "SystemStatus": {
        "type": "object",
        "properties": {
          "backup": {
            "$ref": "#/components/schemas/BackupStatus"
          }
        },
        "required": [
          "backup"
        ]
      },
      "BackupStatus": {
        "type": "object",
        "properties": {
          "latestRun": {
            "$ref": "#/components/schemas/BackupRun"
          },
          "lastSuccessfulRun": {
            "$ref": "#/components/schemas/BackupRun"
          },
          "recentRuns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BackupRun"
            }
          }
        },
        "required": [
          "latestRun",
          "lastSuccessfulRun",
          "recentRuns"
        ]
      },
      "BackupRun": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "019aa5f0-0000-7000-8000-000000000301"
          },
          "startedAt": {
            "type": "string",
            "example": "2026-11-21T06:00:00.000Z"
          },
          "finishedAt": {
            "type": "string",
            "example": "2026-11-21T06:00:04.000Z"
          },
          "status": {
            "$ref": "#/components/schemas/BackupRunStatus"
          },
          "sizeBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "example": 98304
          },
          "error": {
            "type": [
              "string",
              "null"
            ],
            "example": "offsite copy failed: repository does not exist"
          }
        },
        "required": [
          "id",
          "startedAt",
          "finishedAt",
          "status",
          "sizeBytes",
          "error"
        ]
      },
      "BackupRunStatus": {
        "type": "string",
        "enum": [
          "succeeded",
          "failed"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Report the API and database status",
        "security": [],
        "responses": {
          "200": {
            "description": "The API is running and the database answers",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUp"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The API is running but the database does not answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthDown"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/enrollment/options": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Start the enrollment of a passkey with the token of an enrollment link",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Options for navigator.credentials.create()",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyOptions"
                }
              }
            }
          },
          "400": {
            "description": "enrollment_token_invalid: the enrollment link expired, was used or does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The Origin header belongs to another site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/enrollment/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Finish the enrollment, spend the enrollment link and open an access session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The passkey was stored and the hd_session cookie was set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "enrollment_token_invalid or enrollment_failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The Origin header belongs to another site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in/options": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Start a sign-in with a discoverable passkey",
        "security": [],
        "responses": {
          "200": {
            "description": "Options for navigator.credentials.get()",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CeremonyOptions"
                }
              }
            }
          },
          "403": {
            "description": "The Origin header belongs to another site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/sign-in/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Finish the sign-in and open an access session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The passkey was verified and the hd_session cookie was set",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "invalid_request: the body is not a JSON object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "sign_in_failed: the passkey is unknown or the verification failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The Origin header belongs to another site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Report whether the access session cookie is valid",
        "responses": {
          "200": {
            "description": "The access session is valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "auth"
        ],
        "summary": "Sign out: end the access session and clear its cookie",
        "responses": {
          "204": {
            "description": "The access session ended and the cookie was cleared"
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The Origin header belongs to another site",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/muscle-groups": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List the muscle groups in catalog order",
        "responses": {
          "200": {
            "description": "The muscle groups ordered by position",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MuscleGroupList"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/muscles": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List the registered muscles with their muscle group",
        "responses": {
          "200": {
            "description": "The muscles ordered by slug",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MuscleList"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Register a muscle in a muscle group",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddMuscleInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The registered muscle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Muscle"
                }
              }
            }
          },
          "400": {
            "description": "Missing muscle group (muscle_group_required) or missing name (muscle_name_required)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "A muscle with the same name already exists (muscle_already_exists)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "The muscle group is not in the catalog (muscle_group_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/exercises": {
      "get": {
        "tags": [
          "catalog"
        ],
        "summary": "List the active exercises with their muscles and muscle groups",
        "responses": {
          "200": {
            "description": "The active exercises ordered by slug",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExerciseList"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "catalog"
        ],
        "summary": "Register a reps or time exercise with the muscles it works",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddExerciseInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The registered exercise",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exercise"
                }
              }
            }
          },
          "400": {
            "description": "Missing name (exercise_name_required), missing kind (exercise_kind_required), kind other than reps or time (exercise_kind_invalid), no primary muscle (exercise_muscle_required) or a muscle given twice (exercise_muscle_duplicated)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid access session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "An exercise with the same name already exists (exercise_already_exists)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "A muscle is not in the catalog (muscle_not_found)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
